[{"body":"\n<div style=\"display: flex;\">\n  <div style=\"flex: 1; padding-right: 20px;\">\n    Hi, I'm Sashank!\n    \n    I'm a research scientist with 10+ years of experience studying the failure modes of intelligent systems. Currently, I work on model behaviour & alignment of open-weight models at <a href=\"https://reflection.ai/\" rel=\"noreferrer\" target=\"_blank\">**Reflection** &#x2197;</a>.\n    \n    Previously, I lead a research team at Atla training <a href=\"https://arxiv.org/abs/2501.17195\" rel=\"noreferrer\" target=\"_blank\">general-purpose evaluators &#x2197;</a>, prior to which I was at Limbic building <a href=\"https://www.nature.com/articles/s41591-026-04278-w\" rel=\"noreferrer\" target=\"_blank\">safety guardrails &#x2197;</a> for mental health applications. Before that, I was a postdoc at Princeton studying <a href=\"https://nivlab.princeton.edu/wp-content/uploads/sites/938/2025/01/1-s2.0-S1364661322002431-main.pdf\" rel=\"noreferrer\" target=\"_blank\">continual learning failures &#x2197;</a> in psychotherapy, following my PhD in computational neuroscience studying <a href=\"https://www.simonsfoundation.org/news/in-mapping-mistakes-a-window-to-the-inner-mind/\" rel=\"noreferrer\" target=\"_blank\">lapses &#x2197;</a> in decision-making.\n\n    I enjoy making music and writing <a href=\"https://thelemonbot.wordpress.com\" rel=\"noreferrer\" target=\"_blank\">poems &#x2197;</a>. email: firstname[dot]lastname[at]gmail.com\n\n    <ul style=\"list-style-type: none; padding: 0; margin-top: 20px;\">\n      <li style=\"display: inline-block; margin-right: 10px;\">\n        <a href=\"https://github.com/spisupat/\" target=\"_blank\" rel=\"noopener noreferrer\">\n          <i class=\"fab fa-github fa-2x\"></i>\n        </a>\n      </li>\n      <li style=\"display: inline-block; margin-right: 10px;\">\n        <a href=\"https://twitter.com/sashankpisupati\" target=\"_blank\" rel=\"noopener noreferrer\">\n          <i class=\"fab fa-twitter fa-2x\"></i>\n        </a>\n      </li>\n      <li style=\"display: inline-block; margin-right: 10px;\">\n        <a href=\"https://www.linkedin.com/in/spisupati/\" target=\"_blank\" rel=\"noopener noreferrer\">\n          <i class=\"fab fa-linkedin fa-2x\"></i>\n        </a>\n      </li>\n      <li style=\"display: inline-block;\">\n        <a href=\"https://scholar.google.com/citations?user=92jL7vsAAAAJ&hl=en\" target=\"_blank\" rel=\"noopener noreferrer\">\n          <i class=\"ai ai-google-scholar fa-2x\"></i>\n        </a>\n      </li>\n    </ul>\n  </div>\n  <div style=\"flex: 1;\">\n    <img src=\"assets/headshot.jpg\" alt=\"Headshot\" style=\"max-width: 100%; height: auto;\">\n  </div>\n</div>\n","metadata":{"eleventyNavigation":{"order":0,"title":"About me"},"permalink":"/","file":{"root":"/","dir":"/Users/pisupati/Desktop/projects/playground/nonplain-11ty-website/files","base":"index.md","ext":".md","name":"index"},"title":"About me"}}]